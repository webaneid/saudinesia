# ─── Database (Hostinger VPS) ──────────────────────────────────
DATABASE_URL=postgresql://saudinesia:your_db_password@postgres:5432/saudinesia

# ─── Redis (Hostinger VPS) ─────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── MinIO (Hostinger VPS) ─────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=saudinesia-docs
# Host PUBLIK untuk URL presigned (foto & preview dokumen). Kosong = dev lokal (pakai MINIO_ENDPOINT langsung).
# Production WAJIB diisi (https://<FILES_DOMAIN>) — lihat docs/deployment.md.
MINIO_PUBLIC_URL=
# Public URL for hotel/muthowif image display via next/image MinIO loader:
NEXT_PUBLIC_MINIO_PUBLIC_URL=https://your-vps-ip:9000/saudinesia-docs

# ─── Auth ──────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=replace_with_64_char_random_hex

# ─── WhatsApp Gateway — GOWA (Sumopod) ─────────────────────────
# go-whatsapp-web-multidevice by aldinokemal
WA_GATEWAY_URL=https://your-gowa-instance.sumopod.app
WA_GATEWAY_TOKEN=your_gowa_api_token

# ─── Email (Resend) ─────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Produksi: domain pengirim harus terverifikasi di Resend (SPF/DKIM). Dev: onboarding@resend.dev hanya bisa mengirim ke email pemilik akun Resend.
RESEND_FROM=Saudinesia <noreply@saudinesia.com>
# RESEND_REPLY_TO=cs@saudinesia.com

# Login Google (opsional; kosong = tombol tidak tampil). Dev: tambahkan http://localhost:6260/api/v1/auth/google/callback ke Authorized redirect URIs.
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

# Origin publik untuk tautan di email (runtime — beda dari NEXT_PUBLIC_APP_URL yang di-inline saat build).
APP_URL=http://localhost:6260

# ─── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://saudinesia.com
NODE_ENV=production
# Hanya dev lokal: true = lewati rate limit auth. DIABAIKAN kecuali NODE_ENV=development (lib/auth/rateLimit.ts).
# RATE_LIMIT_DISABLED=true

# ─── Business / Payment (lib/constants/payment.ts) ─────────────
# Dipakai instruksi transfer wizard/checkout DAN kop invoice PDF (docs/arsitektur-booking.md §6 Step 7)
NEXT_PUBLIC_BUSINESS_NAME=Saudinesia
NEXT_PUBLIC_BUSINESS_WA=628xxxxxxxxxx
NEXT_PUBLIC_BUSINESS_ADDRESS=Jl. Contoh No. 1, Jakarta Selatan
NEXT_PUBLIC_BANK_1_NAME=BCA
NEXT_PUBLIC_BANK_1_NUMBER=1234567890
NEXT_PUBLIC_BANK_2_NAME=Mandiri
NEXT_PUBLIC_BANK_2_NUMBER=0987654321
# Logo invoice (opsional) — taruh file di public/logo.png, invoice render teks-only kalau tidak ada

# ─── Docker Compose secrets (used by docker-compose.yml only) ──
POSTGRES_PASSWORD=replace_with_strong_db_password
