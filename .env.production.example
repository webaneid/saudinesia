# .env.production.example
# Referensi nilai production. JANGAN diisi manual di repo — di SERVER, jalankan:
#   bash scripts/buat-env-production.sh <APP_DOMAIN> <FILES_DOMAIN>
# yang membuat .env.production dengan rahasia acak. .env.production yang asli JANGAN PERNAH di-commit.

# ─── Dibaca docker compose (interpolasi) & Caddy ──────────────────
# GITHUB_REPO & IMAGE_TAG TIDAK di sini: ditulis ke .env.deploy oleh langkah deploy.
APP_DOMAIN=
FILES_DOMAIN=

# ─── Database ─────────────────────────────────────────────────────
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://saudinesia:CHANGE_ME@postgres:5432/saudinesia

# ─── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── MinIO ────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=saudinesia-docs
# Host PUBLIK tempat URL presigned ditandatangani — WAJIB = https://$FILES_DOMAIN. Tanpa ini URL foto & preview
# dokumen berisi "minio:9000" (nama service Docker) yang tidak bisa dibuka browser.
MINIO_PUBLIC_URL=

# ─── Auth ─────────────────────────────────────────────────────────
JWT_SECRET=

# ─── WhatsApp (GOWA di Sumopod, eksternal) ────────────────────────
WA_GATEWAY_URL=
WA_GATEWAY_TOKEN=

# Secret webhook pesan masuk GOWA (verifikasi nomor WhatsApp) — HARUS sama dengan WHATSAPP_WEBHOOK_SECRET di GOWA (Sumopod).
# Di GOWA atur juga: WHATSAPP_WEBHOOK=https://<APP_DOMAIN>/api/v1/webhooks/whatsapp dan WHATSAPP_WEBHOOK_EVENTS=message.
# WAJIB ≥32 karakter acak; secret lemah/bawaan GOWA (`secret`) ditolak = webhook mati. Kosong = webhook mati (fail-closed) dan nomor WhatsApp tidak bisa diverifikasi (notifikasi tetap lewat email). Isi: openssl rand -hex 32
WHATSAPP_WEBHOOK_SECRET=

# ─── Email (Resend) ───────────────────────────────────────────────
# Wajib verifikasi domain pengirim di Resend (SPF + DKIM, lalu DMARC) SEBELUM go-live — lihat docs/arsitektur-notifikasi.md §8.
# Tanpa API key / FROM, email TIDAK dikirim dan dicatat "dilewati" di Log Notifikasi (bukan pura-pura "terkirim").
RESEND_API_KEY=
# Format: Saudinesia <noreply@domain-terverifikasi>  (domain harus sudah terverifikasi di Resend)
RESEND_FROM=
# Opsional: alamat balasan jamaah (mis. CS). Hilangkan tanda # untuk mengaktifkan.
# RESEND_REPLY_TO=

# ─── Login Google (opsional — kosong = tombol Google tidak tampil) ────
# Google Cloud Console → OAuth consent screen (External; scope openid/email/profile) → Credentials → OAuth client ID (Web application).
# Authorized redirect URI persis: https://<APP_DOMAIN>/api/v1/auth/google/callback  (Admin → Pengaturan → Integrasi menampilkannya). Hilangkan tanda # untuk mengaktifkan.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# URL publik (runtime) untuk tombol/tautan di email. Diisi otomatis dari APP_DOMAIN oleh scripts/buat-env-production.sh.
# Kosong = email dikirim TANPA tautan (tidak pernah tautan relatif).
APP_URL=

NODE_ENV=production

# ─── BUKAN di file ini: NEXT_PUBLIC_* ─────────────────────────────
# NEXT_PUBLIC_APP_URL, NEXT_PUBLIC_MINIO_PUBLIC_URL, NEXT_PUBLIC_BUSINESS_*, NEXT_PUBLIC_BANK_* di-INLINE Next.js
# saat build (lihat ARG di Dockerfile). Mengisinya di sini tidak berpengaruh — set sebagai GitHub Variables
# (Settings → Secrets and variables → Actions → Variables); workflow build meneruskannya sebagai --build-arg.
