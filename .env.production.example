# .env.production.example
# Referensi nilai production. JANGAN diisi manual di repo — di SERVER, jalankan:
#   bash scripts/buat-env-production.sh <APP_DOMAIN> <ADMIN_DOMAIN> <FILES_DOMAIN>
# yang membuat .env.production dengan rahasia acak. .env.production yang asli JANGAN PERNAH di-commit.

# ─── Dibaca docker compose (interpolasi) & Caddy ──────────────────
# GITHUB_REPO & IMAGE_TAG TIDAK di sini: ditulis ke .env.deploy oleh langkah deploy.
APP_DOMAIN=
# Panel admin di host sendiri (docs/rencana-domain-admin.md): admin.saudinesia.id/bookings. Juga dibaca aplikasi (middleware, login).
ADMIN_DOMAIN=
FILES_DOMAIN=

# ─── Database ─────────────────────────────────────────────────────
# Dua peran (SEC-303, docs/deployment.md "Peran database"): `saudinesia` = pemilik skema/superuser bootstrap, HANYA untuk kontainer migrate;
# `saudinesia_app` = peran web, DML saja (dibuat otomatis oleh kontainer migrate dari APP_DB_PASSWORD). Sandi berbeda.
POSTGRES_PASSWORD=
MIGRATE_DATABASE_URL=postgresql://saudinesia:CHANGE_ME@postgres:5432/saudinesia
APP_DB_PASSWORD=
DATABASE_URL=postgresql://saudinesia_app:CHANGE_ME@postgres:5432/saudinesia

# ─── Redis ────────────────────────────────────────────────────────
REDIS_PASSWORD=
REDIS_URL=redis://:CHANGE_ME@redis:6379 # sandi HARUS sama dengan REDIS_PASSWORD

# ─── MinIO ────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
# ROOT MinIO — hanya kontainer minio & minio-setup (web mengosongkannya). Kunci di bawahnya = user APLIKASI berpolicy satu bucket,
# dibuat/diperbarui minio-setup tiap deploy (SEC-305). Keduanya WAJIB berbeda.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=saudinesia-docs
# Host PUBLIK tempat URL presigned ditandatangani — WAJIB = https://$FILES_DOMAIN. Tanpa ini URL foto & preview
# dokumen berisi "minio:9000" (nama service Docker) yang tidak bisa dibuka browser.
MINIO_PUBLIC_URL=

# ─── Auth ─────────────────────────────────────────────────────────
JWT_SECRET=

# ─── Data pribadi sensitif (NIK, nomor paspor) — docs/arsitektur-jamaah.md §6, ADR-0005 ─
# Dibuat otomatis oleh scripts/buat-env-production.sh. Dua kunci BERBEDA (64 hex), terpisah dari JWT_SECRET.
# WAJIB dicadangkan: kunci hilang = NIK/paspor tersimpan tak terbaca. Rotasi: docs/deployment.md.
PII_INDEX_KEY=
PII_ENCRYPTION_KEY=
PII_ENCRYPTION_KEY_VERSION=1
# PII_ENCRYPTION_KEYS_RETIRED=

# ─── WhatsApp (GOWA self-host — layanan `gowa` di docker-compose.prod.yml, docs/rencana-gowa-self-host.md) ─
# Internal saja (tak pernah publik). Kredensial Basic dipakai DUA sisi: GOWA (APP_BASIC_AUTH = user:sandi) dan web. Dibuat otomatis
# oleh scripts/buat-env-production.sh (server lama: scripts/tambah-env-gowa.sh). Hubungkan nomor di admin: Sistem → WhatsApp.
WA_GATEWAY_URL=http://gowa:3000
WA_GATEWAY_USER=
WA_GATEWAY_PASSWORD=

# Secret webhook pesan masuk GOWA (verifikasi nomor WhatsApp) — compose meneruskan nilai YANG SAMA ke GOWA (WHATSAPP_WEBHOOK_SECRET).
# WAJIB ≥32 karakter acak; secret lemah/bawaan GOWA (`secret`) ditolak = webhook mati. Dibuat otomatis oleh skrip env.
WHATSAPP_WEBHOOK_SECRET=

# ─── Email (Resend) ───────────────────────────────────────────────
# Wajib verifikasi domain pengirim di Resend (SPF + DKIM, lalu DMARC) SEBELUM go-live — lihat docs/arsitektur-notifikasi.md §8.
# Tanpa API key / FROM, email TIDAK dikirim dan dicatat "dilewati" di Log Notifikasi (bukan pura-pura "terkirim").
RESEND_API_KEY=
# Format: Saudinesia <no-reply@saudinesia.id>  (keputusan pemilik 2026-11-21; domain harus sudah terverifikasi di Resend)
RESEND_FROM=
# Opsional: alamat balasan jamaah (mis. CS). Hilangkan tanda # untuk mengaktifkan.
# RESEND_REPLY_TO=

# ─── Login Google (opsional — kosong = tombol Google tidak tampil) ────
# Google Cloud Console → OAuth consent screen (External; scope openid/email/profile) → Credentials → OAuth client ID (Web application).
# Authorized redirect URI persis: https://<APP_DOMAIN>/api/v1/auth/google/callback  (Admin → Pengaturan → Integrasi menampilkannya). Hilangkan tanda # untuk mengaktifkan.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# URL publik (runtime) untuk tombol/tautan di email. Diisi otomatis dari APP_DOMAIN oleh scripts/buat-env-production.sh.
# Kosong = email dikirim TANPA tautan (tidak pernah tautan relatif).
APP_URL=

NODE_ENV=production

# ─── BUKAN di file ini: NEXT_PUBLIC_* ─────────────────────────────
# NEXT_PUBLIC_APP_URL, NEXT_PUBLIC_MINIO_PUBLIC_URL, NEXT_PUBLIC_BUSINESS_*, NEXT_PUBLIC_BANK_* di-INLINE Next.js
# saat build (lihat ARG di Dockerfile). Mengisinya di sini tidak berpengaruh — set sebagai GitHub Variables
# (Settings → Secrets and variables → Actions → Variables); workflow build meneruskannya sebagai --build-arg.

# iPaymu (Fase 9, docs/arsitektur-booking-engine-v2.md §10.12): nomor VA merchant + API key dari dasbor iPaymu (sandbox atau produksi —
# mode dipilih di Pengaturan Invoice). Kosong = bayar online tidak tampil (fail-closed). Atur URL notifikasi = <APP_URL>/api/v1/webhooks/ipaymu.
IPAYMU_VA=
IPAYMU_API_KEY=
# Sandbox iPaymu hanya berlaku di development atau bila =1 (server staging). Di produksi biarkan kosong: saklar sandbox di DB lalu mematikan bayar online (SEC-257).
IPAYMU_SANDBOX_ALLOWED=
