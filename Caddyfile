# Caddyfile
# Caddy mengurus sertifikat HTTPS (Let's Encrypt) otomatis begitu DNS domain mengarah ke IP VPS — tanpa certbot.
# Domain TIDAK dikeraskan di sini: dibaca dari environment container (docker-compose.prod.yml):
#   APP_DOMAIN    → situs publik + area jamaah (Next.js), mis. app.saudinesia.id
#   ADMIN_DOMAIN  → panel admin (Next.js yang sama; middleware me-rewrite `/X` → `/id/admin/X`), mis. admin.saudinesia.id
#                   — docs/rencana-domain-admin.md. Halaman/API admin TIDAK dilayani di APP_DOMAIN dan sebaliknya (lapis
#                   kedua di sini; lapis pertama middleware.ts, akses sesungguhnya getSession() di tiap route).
#   FILES_DOMAIN  → MinIO publik, mis. berkas.saudinesia.com — host yang ditandatangani URL presigned
#                   (MINIO_PUBLIC_URL harus = https://$FILES_DOMAIN). Bucket tetap PRIVAT: tanpa tanda tangan
#                   presigned yang valid, MinIO menolak akses.
# Ketiga A record harus sudah mengarah ke VPS sebelum Caddy dinyalakan, kalau tidak penerbitan sertifikat gagal.

# Header keamanan untuk semua host.
(keamanan) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        # `?` = bawaan saja: aplikasi boleh memasang lebih ketat (invoice publik bertoken memasang no-referrer — next.config.ts).
        ?Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}

# Proxy ke aplikasi — dipakai kedua cabang batas body di (batas_body).
(aplikasi) {
    reverse_proxy web:3000 {
        # IP klien = alamat yang benar-benar terhubung ke Caddy (Caddy adalah tepi, tanpa CDN di depan).
        # X-Forwarded-For kiriman klien SELALU ditimpa, supaya rate limit & audit per IP tidak bisa diakali dengan
        # memalsukan header. Bila kelak memakai CDN/Cloudflare: atur trusted_proxies dan hapus baris ini.
        header_up X-Forwarded-For {remote_host}
    }
}

# MinIO publik: HANYA baca objek (GET/HEAD). Unggah & operasi tulis lewat server aplikasi (jaringan internal),
# bukan dari internet — jadi semua metode lain ditolak di sini.
(files) {
    import keamanan
    @tolak {
        not method GET HEAD
    }
    respond @tolak 405
    respond /minio/* 404
    # Preview dokumen memakai <iframe> (components/shared/documents/FileViewerDialog.tsx) dari URL presigned, jadi
    # X-Frame-Options: DENY akan memblokirnya. Hanya aplikasi sendiri (situs jamaah DAN panel admin) yang boleh menyematkan.
    header Content-Security-Policy "frame-ancestors https://{$APP_DOMAIN} https://{$ADMIN_DOMAIN}"
    request_body {
        max_size 1KB
    }
}

# Batas body untuk host aplikasi (app & admin).
(batas_body) {
    # Batas body: 8 MB HANYA untuk POST ke route unggah (dokumen/bukti/foto maks 5 MB + overhead multipart);
    # semua body lain maks 1 MB. Zod 3 memvalidasi SEMUA elemen array meski `.max()` sudah terlampaui (GHSA-mrhx-c7xc-m3w5):
    # JSON 8 MB berisi array → ±2 GB RAM per request. Body JSON sah terbesar (teks kaya ≤ 100 ribu karakter) jauh di bawah 1 MB.
    # Ditentukan dari JALUR, bukan Content-Type (req.json() tak memeriksa Content-Type); segmen tanpa titik/persen
    # supaya `..` tak bisa meminjam batas unggah. Route unggah baru WAJIB ditambahkan — dijaga scripts/test-body-limit.ts.
    @unggah {
        method POST
        path_regexp ^/api/v1/((admin/)?bookings/[A-Za-z0-9_-]+/pilgrims/[A-Za-z0-9_-]+/documents|bookings/[A-Za-z0-9_-]+/payment/bukti|admin/customers/[A-Za-z0-9_-]+/pilgrims/[A-Za-z0-9_-]+/documents|account/pilgrims/[A-Za-z0-9_-]+/documents|admin/media/[A-Za-z0-9_-]+/[A-Za-z0-9_-]+|admin/system/qris-accounts/decode)/?$
    }
    handle @unggah {
        request_body {
            max_size 8MB
        }
        import aplikasi
    }
    handle {
        request_body {
            max_size 1MB
        }
        import aplikasi
    }
}

{$APP_DOMAIN} {
    import keamanan
    # Anti-clickjacking: aplikasi hanya boleh di-frame oleh dirinya sendiri. CSP penuh (script-src dst.) belum —
    # Next.js/Tiptap butuh nonce; lihat docs/lessons-learned.md SEC-06.
    header Content-Security-Policy "frame-ancestors 'self'"
    header X-Frame-Options "SAMEORIGIN"
    encode zstd gzip
    # Panel admin hanya di {$ADMIN_DOMAIN} (K3: 404, tanpa menyebut alamat admin). Jalur dibandingkan tanpa membedakan huruf;
    # bentuk tersandi (`%61dmin`, `//admin`) juga ditolak middleware.ts.
    @adminDiApp {
        path_regexp (?i)^/+([a-z]{2}/+)?admin(/|$)
    }
    @apiAdminDiApp {
        path_regexp (?i)^/+api/+v1/+admin(/|$)
    }
    # `handle`, bukan `respond` langsung: urutan bawaan Caddy menjalankan `handle` (batas_body) SEBELUM `respond`.
    handle @adminDiApp {
        respond 404
    }
    handle @apiAdminDiApp {
        respond 404
    }
    import batas_body
}

{$ADMIN_DOMAIN} {
    import keamanan
    header Content-Security-Policy "frame-ancestors 'self'"
    header X-Frame-Options "SAMEORIGIN"
    # Panel admin tak pernah diindeks mesin pencari.
    header X-Robots-Tag "noindex, nofollow"
    encode zstd gzip
    # Alur jamaah/pihak luar (daftar, Google, webhook) hanya di {$APP_DOMAIN} — semua beralamat APP_URL.
    @jamaahDiAdmin {
        path_regexp (?i)^/+api/+v1/+(auth/+(google|register|registration)|webhooks)(/|$)
    }
    handle @jamaahDiAdmin {
        respond 404
    }
    import batas_body
}

{$FILES_DOMAIN} {
    import files
    # Host header diteruskan apa adanya (bawaan Caddy) — URL presigned ditandatangani untuk host ini.
    reverse_proxy minio:9000
}

# Belum punya domain dan hanya mau uji lewat IP? Ganti blok-blok di atas sementara menjadi (HTTP saja, tanpa HTTPS):
#
# :80 {
#     reverse_proxy web:3000
# }
